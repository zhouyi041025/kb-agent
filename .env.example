# LLM provider: stub（离线，无需 Key）| openai（任何 OpenAI 兼容端点）
KB_LLM_PROVIDER=stub
KB_LLM_BASE_URL=https://api.deepseek.com/v1
KB_LLM_API_KEY=
KB_LLM_MODEL=deepseek-chat
KB_LLM_TIMEOUT_SECONDS=30
KB_LLM_MAX_RETRIES=2

# Embedding provider: hashing（离线确定性）| openai
KB_EMBEDDING_PROVIDER=hashing
KB_EMBEDDING_DIM=4096
KB_EMBEDDING_MODEL=

# 检索默认参数
KB_RETRIEVAL_MODE=hybrid
KB_TOP_K=5
KB_CANDIDATE_K=20
KB_USE_RERANK=true
# 检索置信度低于该值时直接拒答（0 表示关闭门控）
KB_MIN_CONFIDENCE=0.45
KB_CONFIDENCE_WINDOW=3

# 服务
KB_INDEX_DIR=.kb_index
KB_KNOWLEDGE_DIR=data/knowledge
KB_CACHE_SIZE=512
